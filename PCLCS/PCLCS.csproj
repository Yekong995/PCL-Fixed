<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<OutputType>Library</OutputType>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<!-- 输出按配置隔离：Debug 与 Release 不能共用 PCLCS\bin\，否则后构建的配置会覆盖另一个，
		     导致 VB 工程从 PCLCS\bin\ 嵌入的 DLL（含编译期注入的密钥）与实际配置不一致。 -->
		<OutDir>bin\$(Configuration)\</OutDir>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<Configurations>Debug;Release;Snapshot</Configurations>
		<Deterministic>true</Deterministic>
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="PolySharp" Version="1.15.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="System.Collections" />
		<Using Include="System.Collections.Generic" />
		<Using Include="System.Collections.Concurrent" />
		<Using Include="System.Text" />
		<Using Include="System.Text.RegularExpressions" />
		<Using Include="System.Net" />
		<Using Include="System.Runtime.CompilerServices" />
		<Using Include="System.Runtime.InteropServices" />
		<Using Include="Newtonsoft.Json" />
		<Using Include="Newtonsoft.Json.Linq" />
		<Using Include="MeloongCore" />
		<Using Include="MeloongCore.Extensions" />
		<Using Include="MeloongCore.Wpf" />
		<Using Include="MeloongCore.Wpf.Extensions" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\MeloongCore\Shared\MeloongCore.csproj" />
	  <ProjectReference Include="..\MeloongCore\Wpf\MeloongCore.Wpf.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>$(DefineConstants);SNAPSHOT</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'" />

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Snapshot|AnyCPU'">
		<Optimize>True</Optimize>
	</PropertyGroup>

	<!-- 内嵌的资源 -->
	<ItemGroup>
		<EmbeddedResource Include="Launch\JavaWrapper.jar" LogicalName="Launch\JavaWrapper.jar" />
		<EmbeddedResource Include="Launch\LwjglUnsafeAgent.jar" LogicalName="Launch\LwjglUnsafeAgent.jar" />
		<EmbeddedResource Include="Resource\WikiEntries.txt" LogicalName="Resource\WikiEntries.txt" />
		<EmbeddedResource Include="Minecraft\OptiFineHashes.json" LogicalName="Minecraft\OptiFineHashes.json" />
	</ItemGroup>
	<ItemGroup>
	  <Reference Include="Microsoft.VisualBasic" />
	  <Reference Include="Microsoft.CSharp" />
	  <Reference Include="System.Net.Http" />
  <Reference Include="System.IO.Compression" />
	  <Reference Include="Newtonsoft.Json">
	    <HintPath>..\Plain Craft Launcher 2\Resources\Newtonsoft.Json.dll</HintPath>
	  </Reference>
	  <Reference Include="System.Drawing" />
	  <Reference Include="Imazen.WebP">
	    <HintPath>..\Plain Craft Launcher 2\Resources\Imazen.WebP.dll</HintPath>
	  </Reference>
	  <Reference Include="CacheCow.Client">
	    <HintPath>..\Plain Craft Launcher 2\Resources\CacheCow.Client.dll</HintPath>
	  </Reference>
	  <Reference Include="CacheCow.Client.FileStore">
	    <HintPath>..\Plain Craft Launcher 2\Resources\CacheCow.Client.FileStore.dll</HintPath>
	  </Reference>
	  <Reference Include="CacheCow.Common">
	    <HintPath>..\Plain Craft Launcher 2\Resources\CacheCow.Common.dll</HintPath>
	  </Reference>
	  <Reference Include="NAudio">
	    <HintPath>..\Plain Craft Launcher 2\Resources\NAudio.dll</HintPath>
	  </Reference>
	  <Reference Include="System.Xaml" />
	</ItemGroup>

	<!-- 编译期注入密钥（可选）。
	     构建时传入：msbuild ... -p:PclMsClientId=xxx -p:PclCurseForgeApiKey=yyy
	     或设置环境变量 PCL_MS_CLIENT_ID / PCL_CURSEFORGE_API_KEY 后构建。
	     留空则不注入，运行时回退到环境变量（见 ModSecret.cs）。请勿提交真实密钥！ -->
	<PropertyGroup>
		<PclMsClientId Condition="'$(PclMsClientId)' == ''">$(PCL_MS_CLIENT_ID)</PclMsClientId>
		<PclCurseForgeApiKey Condition="'$(PclCurseForgeApiKey)' == ''">$(PCL_CURSEFORGE_API_KEY)</PclCurseForgeApiKey>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="$(IntermediateOutputPath)EmbeddedSecrets.g.cs" />
	</ItemGroup>

	<!-- 把生成目标挂到 CoreCompile 的依赖链上，确保它在编译增量检查（Inputs/Outputs 比较）之前运行，
	     否则改变 PclMsClientId 后，第一次构建会因检查时 .g.cs 仍是旧值而跳过编译。 -->
	<PropertyGroup>
		<CoreCompileDependsOn>GenerateEmbeddedSecrets;$(CoreCompileDependsOn)</CoreCompileDependsOn>
	</PropertyGroup>

	<Target Name="GenerateEmbeddedSecrets">
		<ItemGroup>
			<_SecretLine Include="// &lt;auto-generated&gt; 由 MSBuild 生成（PclMsClientId / PclCurseForgeApiKey），请勿提交真实密钥" />
			<_SecretLine Include="namespace PCLCS.Modules%3B" />
			<_SecretLine Include="public static partial class ModSecret" />
			<_SecretLine Include="{" />
			<_SecretLine Include="    public const string EmbeddedOAuthClientId = &quot;$(PclMsClientId)&quot;%3B" />
			<_SecretLine Include="    public const string EmbeddedCurseForgeApiKey = &quot;$(PclCurseForgeApiKey)&quot;%3B" />
			<_SecretLine Include="}" />
		</ItemGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)EmbeddedSecrets.g.cs" Lines="@(_SecretLine)" Overwrite="true" />
	</Target>

	<!-- VB 工程的 Resources.resx 固定从 PCLCS\bin\ 嵌入 PCLCS.dll / MeloongCore*.dll / Microsoft.Win32.Registry.dll。
	     由于输出已按配置隔离到 bin\$(Configuration)\，这里在构建后把当前配置的产物复制回固定路径，
	     保证 VB 工程嵌入的始终是当前配置（含正确注入密钥）的 DLL。 -->
	<Target Name="RefreshEmbeddedDllPath" AfterTargets="Build">
		<ItemGroup>
			<_EmbedDll Include="$(OutDir)*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(_EmbedDll)" DestinationFolder="$(MSBuildProjectDirectory)\bin" SkipUnchangedFiles="false" />
	</Target>

</Project>
